{
  "name": "octopus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Octopus \u2014 the AI that runs your business. Monorepo root.",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check:docs": "node scripts/check-docs.mjs",
    "art:hero": "blender --background --python tools/art/landing-art.py -- --shot hero  --out tools/art/out/hero-deep.png  --webp --webp-dir apps/web/public",
    "clean": "turbo run clean && rimraf node_modules",
    "ai:install": "uv sync --extra dev --directory services/ai",
    "ai:dev": "uv run --directory services/ai uvicorn octopus_ai.main:app --reload --port 8000",
    "ai:lint": "uv run --directory services/ai ruff check .",
    "ai:test": "uv run --directory services/ai pytest -q",
    "art:reach": "blender --background --python tools/art/landing-art.py -- --shot reach --out tools/art/out/node-reach.png --webp --webp-dir apps/web/public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
