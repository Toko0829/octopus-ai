# Octopus — environment template. Copy to .env.local (never commit real secrets).
# Validated at boot by @octopus/config (packages/config/src/env.ts).

# ---- Supabase ----
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — never expose to the client. A leak bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWKS endpoint used by Fastify to verify Supabase JWTs statelessly.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1

# ---- Services ----
API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=info

# ---- Providers (fill when the relevant module is built; see docs/30-modules/integrations.md) ----
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# STRIPE_SECRET_KEY=
# TRIGGER_SECRET_KEY=
