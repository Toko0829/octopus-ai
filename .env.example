# Octopus environment template. Copy the relevant block into a local, git-ignored file.
# Supabase's new key format: sb_publishable_... (public) and sb_secret_... (secret).
# RULE: an sb_secret_... key never goes in the web file or any NEXT_PUBLIC_ variable.
# Validated at boot by @octopus/config (packages/config/src/env.ts).

# ============ Web app  ->  apps/web/.env.local (PUBLIC only) ============
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ============ API service  ->  apps/api/.env (server only) ============
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER ONLY. A leak bypasses row-level security. Never in a NEXT_PUBLIC_ var, never in chat.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used by Fastify to verify Supabase user JWTs statelessly (jose + JWKS).
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1

API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Python AI service (ADR-0006). Node calls it for reasoning; it never calls back.
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development
LOG_LEVEL=info

# ---- Providers (fill when the relevant module is built; see docs/30-modules/integrations.md) ----
# Generation + embeddings (ADR-0007). One key covers both.
# OPENAI_API_KEY=
# Rerank only. OpenAI has no reranker, so this stays a separate provider.
# COHERE_API_KEY=
# Client-side ceiling on rerank calls per minute. 0 (default) means unlimited.
# Set this ONLY on a rate-limited key: a Cohere trial key allows 10/minute, and
# query decomposition spends up to seven calls on a single goal. Leave it unset
# in production, where throttling retrieval would be self-inflicted latency.
# COHERE_RERANK_RPM=8

# Embedding provider (ADR-0008): `openai` (default) or `local` for in-process
# BAAI/bge-m3. Both emit 1024 dims, so halfvec(1024) is unchanged, but the two
# vector spaces are NOT interchangeable: switching re-embeds the whole corpus,
# which the ingestion content hash enforces automatically.
# `local` needs the extra: uv sync --extra local-embed
# EMBED_PROVIDER=openai
# The model's IDENTITY. Written to doc_chunks.embed_model and folded into the
# ingestion hash, so keep it stable across machines.
# EMBED_LOCAL_MODEL=BAAI/bge-m3
# Optional LOCATION: where the weights sit on this host. Kept separate from the
# identity so moving the cache never rewrites provenance or forces a needless
# re-embed. Required for HF_HUB_OFFLINE=1, where a bare repo id fails on the
# unused onnx/ files; see DEVELOPMENT.md.
# EMBED_LOCAL_PATH=
# STRIPE_SECRET_KEY=
# TRIGGER_SECRET_KEY=
