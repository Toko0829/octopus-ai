# Octopus environment template. Copy the relevant block into a local, git-ignored file.
# Supabase's new key format: sb_publishable_... (public) and sb_secret_... (secret).
# RULE: an sb_secret_... key never goes in the web file or any NEXT_PUBLIC_ variable.
# Validated at boot by @octopus/config (packages/config/src/env.ts).

# ============ Web app  ->  apps/web/.env.local (PUBLIC only) ============
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ============ API service  ->  apps/api/.env (server only) ============
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SERVER ONLY. A leak bypasses row-level security. Never in a NEXT_PUBLIC_ var, never in chat.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used by Fastify to verify Supabase user JWTs statelessly (jose + JWKS).
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1

API_PORT=3001
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Python AI service (ADR-0006). Node calls it for reasoning; it never calls back.
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development
LOG_LEVEL=info

# ---- Providers (fill when the relevant module is built; see docs/30-modules/integrations.md) ----
# Generation + embeddings (ADR-0007). One key covers both.
# OPENAI_API_KEY=
# Rerank fallback only. Reranking runs in-process by default (ADR-0009), so this
# is REQUIRED ONLY when RERANK_PROVIDER=cohere.
# COHERE_API_KEY=
# Client-side ceiling on rerank calls per minute. 0 (default) means unlimited.
# Set this ONLY on a rate-limited key: a Cohere trial key allows 10/minute, and
# query decomposition spends several calls on a single goal.
# COHERE_RERANK_RPM=8

# Embedding provider (ADR-0008): `openai` (default) or `local` for in-process
# BAAI/bge-m3. Both emit 1024 dims, so halfvec(1024) is unchanged, but the two
# vector spaces are NOT interchangeable: switching re-embeds the whole corpus,
# which the ingestion content hash enforces automatically.
# `local` needs the extra: uv sync --extra local-embed
# EMBED_PROVIDER=openai
# The model's IDENTITY. Written to doc_chunks.embed_model and folded into the
# ingestion hash, so keep it stable across machines.
# EMBED_LOCAL_MODEL=BAAI/bge-m3
# Optional LOCATION: where the weights sit on this host. Kept separate from the
# identity so moving the cache never rewrites provenance or forces a needless
# re-embed. Required for HF_HUB_OFFLINE=1, where a bare repo id fails on the
# unused onnx/ files; see DEVELOPMENT.md.
# EMBED_LOCAL_PATH=

# Rerank provider (ADR-0009): `local` (default) for in-process
# BAAI/bge-reranker-v2-m3, or `cohere` for the hosted fallback.
#
# NOTE the asymmetry with EMBED_PROVIDER above: the embedder defaults to openai
# so a plain `uv sync` never needs torch, but the reranker default DOES require
# `uv sync --extra local-embed` and the weights. A deployment without them fails
# at the first rerank.
# RERANK_PROVIDER=local
# RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# Optional LOCATION, same identity/location split as the embedder above.
# RERANK_LOCAL_PATH=
# The threshold for the LOCAL model's scale. NOT interchangeable with
# RERANK_MIN_SCORE: bge's separation sits ~40x lower than Cohere's. Calibrated
# against the golden set, and its margin (1.76x) is the tightest safety property
# in retrieval. Re-measure on any corpus change; see ADR-0009.
# RERANK_LOCAL_MIN_SCORE=0.0013

# How many RRF survivors reach the reranker. A MEASURED setting tied to corpus
# size, not a constant: at 43 chunks RRF already places the answer at rank 1-3,
# so 25 leaves ample headroom. RAISE IT AS THE CORPUS GROWS.
# RETRIEVAL_CANDIDATES=25

# The groundedness gate (rule 10), between retrieval and generation. ON by
# default, and turning it off is a decision rather than a tuning nit: the rerank
# threshold ranks chunks WITHIN the corpus and cannot tell you the corpus does
# not cover a question. Measured, "conversion tracking in GA4" scores 0.0211
# against a 0.0013 threshold while the legitimate broad goal "get me to my first
# 100 customers" tops out at 0.0018, so no threshold separates them. With this
# off, the service answers questions its sources do not support, and it logs a
# warning at startup saying so. Off is for measuring the stages separately.
# GROUNDEDNESS_CHECK=true
# Empty means the cheap generation tier, which is what decomposition uses. Set it
# only if the judgement needs a stronger model than classification does.
# GROUNDEDNESS_MODEL=

# The labelled ungrounded tier (ADR-0021). ON by default. It runs ONLY where the
# gate returned `unsupported` on a retrieval that returned chunks, which is
# "in-domain, not covered", and answers from general practice with a label the
# code writes rather than the model. Such an answer is grounded=false, carries no
# citations, and CANNOT propose a plan, so it cannot become a task DAG that spends
# money. Legal, tax, permit, medical, financial and the regulated corners of
# marketing are declined in code and fall back to the refusal.
#
# Set false to restore strict grounded-or-refuse. That is a product choice, not a
# safety fix: the tier already cannot cite, plan or spend. Both states are logged
# at startup beside GROUNDEDNESS_CHECK. Expect a deployment with a thin corpus to
# refuse most questions with this off, which is the behaviour the tier exists for.
# UNGROUNDED_FALLBACK=true

# Budget for one grounded planning turn, in ms. Reranking is CPU work, so this
# scales with the cores you give the AI service: ~71s per goal on 12 threads,
# ~230s on one. Raise it on a small instance rather than lowering quality.
#
# It scales with SUB-QUERIES TOO, and that multiplier is the one that bites. The
# ~71s figure is per rerank pass, and QUERY_DECOMPOSITION deliberately buys one
# pass per sub-query (config.py: "ONE RERANK PER SUB-QUERY"), run in a sequential
# await loop in retrieval.py. A goal that decomposes into six therefore pays six
# of them back to back. Measured on a 16-core host with torch on 8 threads: a
# whole-funnel goal decomposed into 6 sub-queries and took 498s end to end, so
# every value below 500000 timed out on a machine nobody would call small.
#
# Size this from the WORST case, not the typical one, because the failure it
# prevents is asymmetric. Overshooting costs a longer wait on a run that was
# always going to be slow, and agent runs are asynchronous (202 + runId) so
# nobody is held on a socket. Undershooting discards a completed answer and
# reports a timeout instead, and when that answer was a refusal the person is
# told the service gave up rather than that their goal is out of scope. That is
# the same class of defect as reporting a timeout as an outage.
# AI_REQUEST_TIMEOUT_MS=90000

# Budget for one intake turn, in ms. Much shorter than the planning one on
# purpose: intake is a single cheap-tier call with no retrieval, measured at
# ~1.3s warm, and a hung service must not hold someone for a minute and a half
# before asking them a question.
#
# Raise it for the COLD case rather than the slow one. The AI service loads a
# 2.2GB embedder during startup and does not serve until it has, so a request
# arriving during a boot, a deploy, or a `--reload` in development queues behind
# that. When intake times out the run plans on the raw message instead, which is
# the designed degradation and looks like intake never happened.
# INTAKE_REQUEST_TIMEOUT_MS=20000

# The plan and executor calls need far more room than a classification call, and
# the gpt-5 family counts reasoning tokens against this limit. At 900 the plan
# JSON came back truncated and every whole-funnel goal silently degraded to prose.
# GENERATION_MAX_TOKENS_LONG=4000

# How often the durable backbone walks the task DAG (ADR-0010). A heartbeat
# rather than an event stream: approving a plan already ticks inline, so this
# only bounds how quickly background progress and lost workers are noticed.
# TICK_INTERVAL_MS=30000

# Re-read the external source registry (apps/api/src/lib/crawl-registry.ts) on a
# cadence, so the corpus holds current regulator and ad-platform pages rather
# than only what we wrote ourselves.
#
# OFF by default, and it should stay off on a laptop. The registry names real
# public pages; a dozen developers each fetching them on boot and on every
# interval is a burst of pointless traffic aimed at somebody else's servers. One
# deployment crawls, and everything else reads what it ingested.
# CRAWL_ENABLED=false
# CRAWL_MAX_PER_TICK=2

# Publish campaigns an owner has approved, on the same pass.
# ON by default, which is the opposite of the crawl above and for the opposite
# reason: there is no stranger to protect here. Nothing publishes until somebody
# connects an account and approves a campaign with a budget on it, and the only
# registered provider makes no network call. Set it to `false` to stop a
# deployment publishing; that is a kill switch, not the authorisation.
# PUBLISH_ENABLED=true
# PUBLISH_MAX_PER_TICK=3

# Record what live campaigns spent, on the same pass. ON by default, sharing the
# publish flag's polarity: reads only, appends only, and inert until a campaign is
# live. Off would leave the project panel's spend block saying "No numbers yet"
# about a campaign that really was spending. Each campaign catches up at most
# seven days per pass.
# METRICS_ENABLED=true
# METRICS_MAX_PER_TICK=3

# Pause live campaigns that breach the cost-per-conversion ceiling their owner
# typed on the project panel, on the same pass. ON by default, and of the three
# sweep flags this one has the strongest claim to it: the sweep is doubly inert
# until a person opts in by typing a ceiling, and setting the ceiling IS the
# authorisation to pause (ADR-0014), so off would make a figure somebody typed
# an unenforced promise. A kill switch: `false` stops a deployment pausing, and
# campaigns are still measured and shown.
# OPTIMIZE_ENABLED=true
# OPTIMIZE_MAX_PER_TICK=3

# Offer escalated steps to expert nodes, one at a time, cascading on a decline or
# a 48-hour expiry. ON by default, with the sweep flags rather than with the
# crawler: the crawler opts in because it reaches somebody else's servers, and
# this reaches nobody. It is also doubly inert, since nothing enters `matching`
# except an owner clicking "Find an expert" on a step that stopped. Off by
# default would leave that button moving a step to `matching` where it waits
# forever, which is the false surface this slice exists to remove. A kill switch:
# `false` still lets a step be dispatched and still shows "Finding an expert",
# and no offer is ever made. MAX_PER_TICK bounds offers CREATED, not tasks read,
# so a backlog of cascades cannot starve the one offer ready to go out.
# MATCHER_ENABLED=true
# MATCHER_MAX_PER_TICK=3

# Give back escrow held against steps that stopped before they were delivered,
# on the same pass. ON by default, and of the five sweep flags this is the one
# whose absence takes something away: a step cancelled after its escrow was
# funded leaves the hold at `held` forever, a held hold counts against the
# project budget ceiling (ADR-0020), and nothing else in the product can release
# it. Doubly inert like its siblings, since it only ever looks at held holds on
# cancelled or failed steps. A kill switch: `false` still lets steps be accepted
# and funded, and no hold is ever unwound. Nothing is charged and nothing is
# refunded at a provider, because the only registered provider is the in-repo
# fake. MAX_PER_TICK bounds refunds PERFORMED, not holds read.
# ESCROW_RECONCILE_ENABLED=true
# ESCROW_RECONCILE_MAX_PER_TICK=3

# Returns a step to the marketplace when the expert who took it missed the agreed
# date, refunding the hold so the owner's ceiling stops counting it. On unless
# set to `false`, like every sweep except the crawler. What turning it off costs
# is worth stating: an abandoned step then sits at `escrow_funded` forever with
# its hold pinning part of the budget, which is the dead end slice 6 exists to
# close. Doubly inert until somebody actually misses a deadline, since it selects
# only live engagements past `deadline_at` whose task is still `escrow_funded` or
# `in_progress`. It never touches a step that was handed over: a deadline passing
# after delivery is the owner's failure to review, not the node's failure to work.
# A node inside the last 24 hours is warned in their thread first, once ever.
# MAX_PER_TICK bounds reassignments PERFORMED, not engagements read, and is small
# for a second reason its siblings do not have: each one produces a task at
# `matching` that the matcher picks up in the same pass.
# NO_SHOW_ENABLED=true
# NO_SHOW_MAX_PER_TICK=3

# Signs the OAuth `state` parameter when connecting a channel account.
#
# **Unset by default, and there is deliberately no fallback value.** `state` is
# the only thing standing between a workspace and somebody else's ad account:
# without it, anyone can send a signed-in person's browser to our callback
# carrying a code for an account they never chose. A signing key checked into a
# repository signs a state anybody can forge, so an unset secret refuses to
# connect anything rather than pretending to protect it.
#
# Generate one per deployment:  openssl rand -hex 32
# OAUTH_STATE_SECRET=
#
# How long a half-finished authorisation stays valid. Long enough to read a
# consent screen carefully, short because the signature is the whole control and
# there is no server-side record to revoke.
# OAUTH_STATE_TTL_SECONDS=600

# STRIPE_SECRET_KEY=
# TRIGGER_SECRET_KEY=
