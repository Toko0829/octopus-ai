# Dependencies
node_modules/
.pnpm-store/

# Build / cache
.turbo/
dist/
.next/
out/
build/
coverage/
*.tsbuildinfo

# Env & secrets (never commit real secrets)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel / deploy
.vercel

# Editor / agent tooling
.claude/
.agents/
skills-lock.json

# Python (services/ai)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Planning artefacts kept deliberately out of the repository. The xlsx is the
# source the separate tracker app seeds itself from, and it is re-exported
# rather than edited here, so a committed copy would be a second version of it.
Octopus-Project-Plan.xlsx

# rag-lens output. Generated on demand from files that ARE committed, so the
# page is reproducible and a copy in git would only ever be a stale one.
rag-lens.html
rag-trace.json

# Render masters. Regenerated by tools/art/hero-scene.py, which IS committed, so a
# copy in git would only ever be a stale duplicate of something reproducible. The
# shipped derivatives (apps/web/public/*.webp) are committed; the 13MB 16-bit
# masters they are made from are not.
tools/art/out/

# Supabase CLI scratch (version probe, branch refs) — never part of the repo.
supabase/.temp/
